+                  </tbody>
+                </table>
+              )}
+            </div>
+          </td>
+        </tr>
+      )}
+    </>
+  )
+}
+
+// ─── Main Page ────────────────────────────────────────────────────────────────
+
+const PRESET_LABELS: { value: PresetRange; label: string }[] = [
+  { value: 'this_month', label: 'Tháng này' },
+  { value: 'last_month', label: 'Tháng trước' },
