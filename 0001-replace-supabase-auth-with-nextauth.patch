+      </div>
+    </div>
+  )
+}
+
+// ─── Dialog sửa người dùng ────────────────────────────────────────────────────
+
+function EditUserDialog({
+  user,
+  onClose,
+  onSaved,
+}: {
+  user: UserRow
+  onClose: () => void
+  onSaved: () => void
+}) {
+  const [fullName, setFullName] = useState(user.full_name)
