+            <span className="text-gray-300 text-sm">—</span>
+          )}
+        </td>
+      </tr>
+
+      {/* Dòng chi tiết — accordion */}
+      {expanded && (
+        <tr>
+          <td colSpan={4} className="p-0 bg-gray-50 dark:bg-gray-800">
+            <div className="border-t border-gray-100">
+              {group.payments.length === 0 ? (
