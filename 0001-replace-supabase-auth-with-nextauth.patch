+
+  if (!content?.trim()) {
+    return NextResponse.json({ error: 'Nội dung ghi chú không được để trống' }, { status: 400 })
+  }
+  if (!contact_method) {
+    return NextResponse.json({ error: 'Vui lòng chọn hình thức liên hệ' }, { status: 400 })
+  }
+  if (!contact_result) {
