@@ -0,0 +1,127 @@
+@tailwind base;
+@tailwind components;
+@tailwind utilities;
+
+@layer base {
+  :root {
+    --background: 0 0% 100%;
+    --foreground: 222.2 84% 4.9%;
+    --card: 0 0% 100%;
+    --card-foreground: 222.2 84% 4.9%;
+    --popover: 0 0% 100%;
+    --popover-foreground: 222.2 84% 4.9%;
+    --primary: 222.2 47.4% 11.2%;
+    --primary-foreground: 210 40% 98%;
+    --secondary: 210 40% 96.1%;
+    --secondary-foreground: 222.2 47.4% 11.2%;
+    --muted: 210 40% 96.1%;
+    --muted-foreground: 215.4 16.3% 46.9%;
+    --accent: 210 40% 96.1%;
+    --accent-foreground: 222.2 47.4% 11.2%;
+    --destructive: 0 84.2% 60.2%;
+    --destructive-foreground: 210 40% 98%;
+    --border: 214.3 31.8% 91.4%;
+    --input: 214.3 31.8% 91.4%;
+    --ring: 222.2 84% 4.9%;
+    --radius: 0.5rem;
+  }
+}
+
+@layer base {
+  .dark {
+    /* CiT Hub Navy Palette — override Shadcn defaults */
+    --background:    215 60% 10%;    /* #0A1628 navy */
+    --foreground:    215 40% 94%;    /* #e8edf5 */
+    --card:          215 60% 12%;    /* #0d1c33 dark card */
+    --card-foreground: 215 40% 94%; /* #e8edf5 */
+    --popover:       215 60% 12%;   /* #0d1c33 */
+    --popover-foreground: 215 40% 94%;
+    --primary:       15 80% 51%;    /* #E8471A flame */
+    --primary-foreground: 0 0% 100%;
+    --secondary:     215 47% 19%;   /* #1a2d4a */
+    --secondary-foreground: 215 40% 94%;
+    --muted:         215 47% 19%;   /* #1a2d4a */
+    --muted-foreground: 215 40% 71%; /* #94b0d6 */
+    --accent:        215 47% 19%;
+    --accent-foreground: 215 40% 94%;
+    --destructive:   0 62.8% 40.6%;
+    --destructive-foreground: 210 40% 98%;
+    --border:        215 46% 33%;   /* #2d4a7a */
+    --input:         215 60% 10%;   /* #0a1628 */
+    --ring:          15 80% 51%;    /* #E8471A flame */
+  }
+}
+
+@layer base {
+  * {
+    @apply border-border;
+  }
+
+  body {
+    @apply bg-background text-foreground;
+    /* system-ui — không load Google Fonts */
+    font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
+    font-size: 16px;
+    line-height: 1.7;
+  }
+}
+
+/* ─── Dark mode form overrides ────────────────────────────────────────────────
+   Viết ngoài @layer để override Tailwind utility classes (bg-white, border-gray-200...)
+   Áp dụng toàn bộ form: Contact, Lead, Class, Payment, Refund
+   ──────────────────────────────────────────────────────────────────────────── */
+
+/* Label — thay text-ink (#111) sang màu đọc được trên nền tối */
+.dark label {
+  color: #94b0d6;
+  font-weight: 500;
+}
+
+/* Dấu * required giữ nguyên màu Flame */
+.dark label .text-flame,
+.dark label span[class*="text-flame"] {
+  color: #E8471A !important;
+}
+
+/* Input / Select / Textarea — nền navy, viền xanh đậm, chữ sáng */
+.dark input:not([type="checkbox"]):not([type="radio"]):not([type="range"]):not([type="color"]):not([type="submit"]):not([type="button"]):not([type="reset"]),
+.dark select,
+.dark textarea {
+  background-color: #0a1628;
+  border-color: #2d4a7a;
+  color: #c8d8f0;
+}
+
+/* Placeholder — đủ sáng để đọc được nhưng vẫn phân biệt với value */
+.dark input::placeholder,
+.dark textarea::placeholder {
+  color: #4a6080;
+  opacity: 1;
+}
+
+/* Focus — viền Flame + glow nhẹ */
+.dark input:not([type="checkbox"]):not([type="radio"]):not([type="range"]):not([type="color"]):not([type="submit"]):not([type="button"]):not([type="reset"]):focus,
+.dark select:focus,
+.dark textarea:focus {
+  border-color: #E8471A;
+  box-shadow: 0 0 0 3px rgba(232, 71, 26, 0.2);
+  outline: none;
+}
+
+/* Disabled / read-only — tối hơn, muted */
+.dark input:disabled,
+.dark select:disabled,
+.dark textarea:disabled,
+.dark input[readonly],
+.dark textarea[readonly] {
+  background-color: #060e1a;
+  color: #4a6080;
+  border-color: #1a2d4a;
+  cursor: not-allowed;
+}
+
+/* Select option dropdown */
+.dark select option {
+  background-color: #0d1f3c;
+  color: #c8d8f0;
+}
