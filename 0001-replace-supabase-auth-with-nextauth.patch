+          className="w-full border border-gray-200 rounded-lg px-4 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-flame/30 focus:border-flame resize-none"
+          placeholder="Thêm ghi chú về contact này..."
+          onKeyDown={(e) => {
