+
+export default function AdminNewContactPage() {
+  return (
+    <div>
+      {/* Breadcrumb */}
+      <div className="flex items-center gap-2 text-sm text-gray-400 mb-4">
+        <Link href="/admin/contacts" className="hover:text-flame">Contacts</Link>
+        <span>/</span>
