+                      </th>
+                    </tr>
+                  </thead>
+                  <tbody>
+                    {group.payments.map((p) => (
+                      <tr
+                        key={p.id}
+                        className="border-b border-gray-100 dark:border-gray-700 last:border-0 hover:bg-gray-50 dark:hover:bg-gray-700 transition-colors"
+                      >
