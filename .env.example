# =============================================================================
# CiT Hub — Environment Variables
# Copy file này thành .env.local, điền giá trị thật, KHÔNG commit .env.local
# =============================================================================

# Supabase — lấy từ Project Settings → API
DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[REF].supabase.co:5432/postgres?pgbouncer=true&connection_limit=1"
NEXT_PUBLIC_SUPABASE_URL="https://[REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="[ANON_KEY]"
SUPABASE_SERVICE_ROLE_KEY="[SERVICE_ROLE_KEY]"

# App
NEXT_PUBLIC_APP_URL="https://hub.citedu.vn"
NODE_ENV="production"

# Google Gemini AI — lấy API key miễn phí tại https://aistudio.google.com/apikey
GEMINI_API_KEY=""
