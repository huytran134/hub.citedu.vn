# =============================================================================
# CiT Hub — Environment Variables
# Copy file này thành .env.local, điền giá trị thật, KHÔNG commit .env.local
# =============================================================================

# Database — MySQL/MariaDB tự host trên Hostinger VPS
DATABASE_URL="mysql://cithub_user:[PASSWORD]@localhost:3306/cithub"

# NextAuth.js — tự quản lý đăng nhập (thay Supabase Auth)
# Tạo NEXTAUTH_SECRET bằng: openssl rand -base64 32
NEXTAUTH_SECRET="[RANDOM_32_BYTE_SECRET]"
NEXTAUTH_URL="https://hub.citedu.vn"

# App
NEXT_PUBLIC_APP_URL="https://hub.citedu.vn"
NODE_ENV="production"

# Google Gemini AI — lấy API key miễn phí tại https://aistudio.google.com/apikey
GEMINI_API_KEY=""
